# Copy to apps/server/.env (git-ignored); `pnpm dev` loads it. In production, set
# these in the Render dashboard instead.

# YouTube Data API v3 key, used for videos.list (track title, duration, embeddable, live)
# and search.list (/play <name>). Server only: never expose it to the web app.
# Without it, /play answers with a notice.
YOUTUBE_API_KEY=

# Set to "fake" to use the in-memory fake track catalog instead of YouTube
# (e2e runs set it in apps/web/playwright.config.ts). See src/radio/fake-track-catalog.ts.
# TRACK_CATALOG=fake

# Set to "fake" to use the in-memory fake music search instead of YouTube for /play <name>
# (e2e runs set it in apps/web/playwright.config.ts). See src/radio/fake-music-search.ts.
# MUSIC_SEARCH=fake

# YouTube Data API v3 key, used for videos.list (track title, duration, embeddable, live).
# Server only: never expose it to the web app. Without it, /play answers with a notice.
YOUTUBE_API_KEY=

# Set to "fake" to use the in-memory fake track catalog instead of YouTube
# (e2e runs set it in apps/web/playwright.config.ts). See src/radio/fake-track-catalog.ts.
# TRACK_CATALOG=fake
